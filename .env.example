# Q-TRANSIT NEXUS Backend Configuration
DATABASE_URL=sqlite:///./qtransit.db
# For PostgreSQL/PostGIS: postgresql://postgres:postgres@localhost:5432/qtransit_db
REDIS_URL=redis://localhost:6379/0
SUMO_BINARY=sumo
SUMO_HOME=C:/Program Files (x86)/Eclipse/Sumo
SECRET_KEY=qtransit_nexus_super_secret_key_2026

# System Mode
ENV=development
DEBUG=True

# -----------------------------------------------------------------------------
# OPTIONAL EXTERNAL API KEYS (FREE TIERS)
# Note: The backend functions 100% standalone out of the box with built-in free
# OpenStreetMap / OSRM / SUMO simulation fallback if these keys are left empty.
# -----------------------------------------------------------------------------

# 1. TomTom Traffic API (Free Tier: 2,500 requests/day)
# Get key for real live traffic feeds at: https://developer.tomtom.com
TOMTOM_TRAFFIC_API_KEY=

# 2. Mapbox API (Free Tier: 100,000 requests/month)
# Get key for matrix calculation at: https://www.mapbox.com
MAPBOX_API_KEY=

# 3. OpenWeatherMap API (Free Tier: 1,000 requests/day)
# Get key for monsoon/weather delay impact at: https://openweathermap.org
OPENWEATHER_API_KEY=
